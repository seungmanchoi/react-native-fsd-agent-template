# EAS uses this file INSTEAD of .gitignore when it packs the project for a build,
# so every secret pattern from .gitignore must be repeated here.
# https://docs.expo.dev/build-reference/easignore/

# Native builds (EAS generates these via prebuild)
ios/
android/

# Dependencies (EAS installs from package.json)
node_modules/

# Build artifacts
.expo/
dist/
web-build/
build-output/
*.aab
*.ipa
*.apk
*.log
*.tsbuildinfo
npm-debug.*

# Secrets & signing — never upload
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
credentials.json
credentials/
keys/
# NOTE: firebase/GoogleService-Info.plist and firebase/google-services.json are
# uploaded on purpose so cloud builds work without EAS file env vars. They only hold
# public client config that ships inside the app binary anyway.

# Store assets & tooling (not needed for the app binary)
assets/store-screenshots/
assets/store-listing/
assets/icons-original/
screenshots/
fastlane/
docs/
scripts/
_workspace/
forms_config.json
*.md

# IDE, agents & automation
.git/
.claude/
.codex/
.agents/
.codegraph/
.github/
.idea/
.vscode/
.playwright-mcp/

# OS files
.DS_Store
Thumbs.db
